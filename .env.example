# PostgreSQL connection string. On Neon use the *pooled* URL here.
DATABASE_URL="postgresql://app:app@localhost:5432/hearth?schema=public"
# Direct (non-pooled) URL used by Prisma Migrate. On Neon use the direct URL.
DIRECT_URL="postgresql://app:app@localhost:5432/hearth?schema=public"
# Database used by `pnpm test` (integration tests truncate it; never point at real data).
TEST_DATABASE_URL="postgresql://app:app@localhost:5432/hearth_test?schema=public"

# Auth.js secret. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-32-random-bytes"
# Public base URL of the app (no trailing slash).
APP_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Shared secret for /api/cron/* routes. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET="replace-me-too"

# Mock KYC: simulated review delay in milliseconds.
KYC_MOCK_DELAY_MS="2500"
